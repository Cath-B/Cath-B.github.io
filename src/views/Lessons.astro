---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { type Lang, routes, otherLang } from '../i18n';
import photo from '../assets/mending-jeans.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  sv: {
    title: 'Sylektioner, en till en',
    description:
      'Privata sylektioner i Stockholm. Cosplay, ett särskilt plagg, ändringar och lagningar, eller att börja sy från grunden.',
    lead: 'Ta med ett projekt du bryr dig om, så jobbar vi med det tillsammans i din takt. Lektionerna utgår från det du vill göra, inte från en färdig kurs.',
    photoAlt: 'Catherine syr en lagning på ett par jeans.',
    forTitle: 'Vad vill du göra?',
    topics: [
      ['Cosplay', 'Mönster, provning och att bli klar med dräkten i tid till eventet.'],
      ['Ett särskilt plagg', 'Från tygval till sista fållen.'],
      ['Ändringar och lagningar', 'Få kläder att sitta bra, eller laga dem så att de håller.'],
      ['Börja från början', 'Symaskinen, grundstygnen och ett första projekt.'],
    ],
    howTitle: 'Så går det till',
    steps: [
      'Berätta vad du vill sy, hur mycket du har sytt tidigare och om du har en deadline.',
      'Jag svarar inom två arbetsdagar med ett förslag: hur många tillfällen och vad det kostar.',
      'Vi ses och syr. Du går hem med kunskapen och det du har gjort.',
    ],
    formTitle: 'Berätta om ditt projekt',
    f: {
      name: 'Namn',
      email: 'E-post',
      phone: 'Telefon',
      kind: 'Typ av projekt',
      kinds: ['Cosplay', 'Ett särskilt plagg', 'Ändringar eller lagningar', 'Lära mig sy från början', 'Något annat'],
      project: 'Vad vill du göra?',
      projectHint: 'Beskriv plagget eller dräkten och vad du vill lära dig.',
      experience: 'Hur mycket har du sytt?',
      levels: ['Aldrig', 'Lite grann', 'En hel del'],
      deadline: 'Deadline',
      deadlineHint: 'Till exempel datum för ett konvent eller en fest.',
      when: 'Dagar och tider som passar',
      reference: 'Länk till referensbilder',
      referenceHint: 'Pinterest, Instagram, en mapp i molnet eller liknande.',
      submit: 'Skicka förfrågan',
      success: 'Tack! Jag har fått din förfrågan och svarar inom två arbetsdagar med ett förslag.',
    },
  },
  en: {
    title: 'Sewing lessons, one to one',
    description:
      'Private sewing lessons in Stockholm. Cosplay, a specific garment, alterations and repairs, or learning to sew from scratch.',
    lead: "Bring a project you care about and we'll work on it together, at your pace. Lessons are built around what you want to make, not a fixed course.",
    photoAlt: 'Catherine stitching a repair on a pair of jeans.',
    forTitle: 'What do you want to make?',
    topics: [
      ['Cosplay', 'Patterns, fitting, and finishing a costume in time for the event.'],
      ['A specific garment', 'From choosing the fabric to the final hem.'],
      ['Alterations and repairs', 'Make clothes fit, or fix them so they last.'],
      ['Learning from scratch', 'The sewing machine, the basic stitches, and a first project.'],
    ],
    howTitle: 'How it works',
    steps: [
      "Tell me what you want to make, how much you've sewn before, and whether there's a deadline.",
      'I reply within two working days with a suggested plan: how many sessions, and what they cost.',
      'We meet and sew. You go home with the skills and the thing you made.',
    ],
    formTitle: 'Tell me about your project',
    f: {
      name: 'Name',
      email: 'Email',
      phone: 'Phone',
      kind: 'Kind of project',
      kinds: ['Cosplay', 'A specific garment', 'Alterations or repairs', 'Learning to sew from scratch', 'Something else'],
      project: 'What do you want to make?',
      projectHint: 'Describe the garment or costume, and what you want to learn.',
      experience: 'How much have you sewn?',
      levels: ['Never', 'A little', 'Quite a lot'],
      deadline: 'Deadline',
      deadlineHint: 'For example the date of a convention or a party.',
      when: 'Days and times that suit you',
      reference: 'Link to reference pictures',
      referenceHint: 'Pinterest, Instagram, a shared folder or similar.',
      submit: 'Send enquiry',
      success: "Thanks! I've got your enquiry and will reply within two working days with a suggested plan.",
    },
  },
}[lang];
const f = copy.f;
---

<Base lang={lang} title={copy.title} description={copy.description} alternate={routes.lessons[otherLang(lang)]} current="lessons">
  <section class="wrap hero">
    <div>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      <p class="ui"><a href="#enquiry">{copy.formTitle}</a></p>
    </div>
    <Image src={photo} alt={copy.photoAlt} widths={[360, 540, 720]} sizes="(min-width: 56rem) 30vw, 100vw" />
  </section>

  <section class="section wrap">
    <h2>{copy.forTitle}</h2>
    <dl class="topics">
      {copy.topics.map(([term, text]) => (
        <div>
          <dt>{term}</dt>
          <dd>{text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section wrap">
    <h2>{copy.howTitle}</h2>
    <ol class="steps">
      {copy.steps.map((s) => <li>{s}</li>)}
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="enquiry">
    <h2 id="enquiry">{copy.formTitle}</h2>
    <EnquiryForm
      lang={lang}
      formType="lessons"
      subject="Lesson enquiry"
      submitLabel={f.submit}
      successMessage={f.success}
      fields={[
        [
          { name: 'name', label: f.name, required: true, autocomplete: 'name' },
          { name: 'email', label: f.email, type: 'email', required: true, autocomplete: 'email' },
        ],
        [
          { name: 'phone', label: f.phone, type: 'tel', autocomplete: 'tel' },
          { name: 'project_kind', label: f.kind, type: 'select', options: f.kinds },
        ],
        { name: 'project', label: f.project, type: 'textarea', required: true, hint: f.projectHint },
        [
          { name: 'experience', label: f.experience, type: 'select', options: f.levels },
          { name: 'deadline', label: f.deadline, hint: f.deadlineHint },
        ],
        { name: 'availability', label: f.when },
        { name: 'reference_link', label: f.reference, type: 'url', hint: f.referenceHint, placeholder: 'https://' },
      ]}
    />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 3fr 2fr;
    }
  }
  .hero :global(img) {
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
  }
  .topics {
    display: grid;
    gap: 1.75rem 3rem;
    margin: 1.5rem 0 0;
  }
  @media (min-width: 44rem) {
    .topics {
      grid-template-columns: 1fr 1fr;
    }
  }
  .topics dt {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-h4);
    margin-bottom: 0.25rem;
  }
  .topics dd {
    margin: 0;
    max-width: 26em;
  }
  .steps {
    margin: 1.5rem 0 0;
    padding-left: 1.5rem;
    display: grid;
    gap: 0.9rem;
    max-width: var(--measure);
  }
  .steps li::marker {
    font-family: var(--sans);
    font-weight: 700;
    color: var(--cobalt);
  }
</style>
