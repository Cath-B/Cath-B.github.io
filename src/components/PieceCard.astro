---
import { Image } from 'astro:assets';
import type { Piece } from '../lib/content';
import { type Lang, pieceUrl, ui } from '../i18n';

interface Props {
  piece: Piece;
  lang: Lang;
}
const { piece, lang } = Astro.props;
const t = ui[lang];
const text = piece.data[lang];
const { status, price } = piece.data;
const cover = piece.data.images[0];
---

<article class="piece" data-status={status}>
  <a href={pieceUrl(lang, piece.id)} class="photo" tabindex="-1" aria-hidden="true">
    <Image src={cover} alt="" widths={[360, 540, 720, 1080]} sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw" />
  </a>
  <h3><a href={pieceUrl(lang, piece.id)}>{text.title}</a></h3>
  <p class="motifs">{text.motifs}</p>
  <p class="meta">
    {status === 'available' ? (
      <span>{price ? t.currency(price) : t.priceOnRequest}</span>
    ) : (
      <span class="status">{t.status[status]}</span>
    )}
  </p>
</article>

<style>
  .piece {
    display: grid;
    align-content: start;
  }
  .photo {
    display: block;
    background-image: none;
    padding: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--wash);
    margin-bottom: 1rem;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  [data-status='sold'] .photo :global(img) {
    opacity: 0.7;
  }
  h3 {
    font-size: var(--t-h4);
    margin: 0 0 0.2rem;
  }
  h3 a {
    color: var(--indigo);
    background-image: none;
  }
  h3 a:hover {
    color: var(--cobalt);
  }
  .motifs {
    font-style: italic;
    margin: 0 0 0.35rem;
    color: var(--indigo-soft);
  }
  .meta {
    font-family: var(--sans);
    font-weight: 600;
    font-size: var(--t-ui);
    margin: 0;
  }
  .status {
    color: var(--madder);
  }
</style>
