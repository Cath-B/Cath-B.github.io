---
import Piece from '../../views/Piece.astro';
import { getShopPieces } from '../../lib/content';

export async function getStaticPaths() {
  const pieces = await getShopPieces();
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}
const { piece } = Astro.props;
---

<Piece lang="sv" piece={piece} />
